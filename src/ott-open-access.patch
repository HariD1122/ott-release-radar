index 0000000..6427b5c
--- /dev/null
+++ b/scripts/reset-pin.mts
@@ -0,0 +1,30 @@
+// Emergency PIN reset for when you are locked out and cannot use Settings.
+// Usage: put NEW_PIN=<4-12 digits> in .env.local (or pass it inline), then `npm run pin:reset`.
+// Resets the owner account (the one the login page signs in to). Set RESET_LOGIN_ID to target another account.
+// Also clears failed-login lockouts and signs out every existing session for that account.
+// Remove NEW_PIN from .env.local afterwards.
+import { neon } from "@neondatabase/serverless";
+import argon2 from "argon2";
+
+const url = process.env.DATABASE_URL;
+const pin = (process.env.NEW_PIN ?? "").trim();
+const target = (process.env.RESET_LOGIN_ID ?? "").trim().replace(/\s+/g, " ").toUpperCase();
+
+if (!url) throw new Error("DATABASE_URL must be set");
+if (!/^\d{4,12}$/.test(pin)) throw new Error("NEW_PIN must be 4 to 12 digits");
+
+const sql = neon(url);
+
+const users = target
+  ? await sql.query("SELECT id, login_id FROM users WHERE login_id = $1", [target])
+  : await sql.query("SELECT id, login_id FROM users WHERE status = 'active' ORDER BY created_at LIMIT 1");
+if (!users.length) throw new Error(target ? `No account with login ID ${target}` : "No active account found; run npm run db:seed first");
+
+const { id, login_id } = users[0] as { id: string; login_id: string };
+const hash = await argon2.hash(pin, { type: argon2.argon2id });
+
+await sql.query("UPDATE users SET pin_hash = $2, status = 'active', updated_at = now() WHERE id = $1", [id, hash]);
+await sql.query("DELETE FROM login_attempts WHERE login_id = $1 AND succeeded = false", [login_id]);
+await sql.query("DELETE FROM sessions WHERE user_id = $1", [id]);
+
+console.log(`PIN reset for ${login_id}. Lockout cleared and all sessions signed out. Remove NEW_PIN from .env.local now.`);
